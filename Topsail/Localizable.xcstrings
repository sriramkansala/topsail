    "Add your script in Settings › Features › Teleprompter.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu texto en Ajustes › Funciones › Teleprónter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre texte dans Réglages › Fonctionnalités › Prompteur."
          }
        }
      }
    },
