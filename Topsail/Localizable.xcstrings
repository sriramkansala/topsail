    "An Apps tab with your Terminal's output, Chrome's tabs and a YouTube play button, while those apps are open.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pestaña Apps con la salida de tu Terminal, las pestañas de Chrome y un botón de reproducción de YouTube, mientras esas apps están abiertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un onglet Apps avec la sortie de votre Terminal, les onglets de Chrome et un bouton de lecture YouTube, quand ces apps sont ouvertes."
          }
        }
      }
    },
    "Another app already uses %@. Turn it off there or pick a different shortcut.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra app ya usa %@. Desactívalo allí o elige otro atajo."
