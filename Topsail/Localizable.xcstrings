    "Wait for my answer": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperar mi respuesta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendre ma réponse"
          }
        }
      }
    },
    "Waiting for you": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te está esperando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous attend"
          }
        }
      }
    },
    "What your Mac plays, and the other side of a call.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que reproduce tu Mac y la otra parte de una llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que joue votre Mac, et l’autre côté d’un appel."
          }
        }
      }
    },
    "Will be applied": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplicará"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sera appliqué"
          }
        }
      }
    },
    "Without mic": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin micrófono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans micro"
          }
        }
      }
    },
    "Working": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabajando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travaille"
          }
        }
      }
    },
    "Yesterday": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier"
          }
        }
      }
    },
    "Your side only": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tu parte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre côté seulement"
          }
        }
      }
    },
    "Your voice and the Mac's sound stay apart in calls, for editing. Screen recordings are mixed until macOS 27.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu voz y el sonido del Mac quedan separados en las llamadas, para editarlos. Las grabaciones de pantalla se mezclan hasta macOS 27."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre voix et le son du Mac restent séparés dans les appels, pour le montage. Les enregistrements de l’écran sont mixés avant macOS 27."
          }
        }
      }
    },
    "Your voice and the Mac's sound stay apart, for editing. Off, they're mixed into one track.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu voz y el sonido del Mac quedan separados, para editarlos. Desactivado, se mezclan en una sola pista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre voix et le son du Mac restent séparés, pour le montage. Désactivé, ils sont mixés sur une seule piste."
          }
        }
      }
    },
    "Your voice, with the screen and as your side of a call.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu voz, con la pantalla y como tu parte de una llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre voix, avec l’écran, et votre côté d’un appel."
          }
        }
      }
    },
    "YouTube in Chrome": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube en Chrome"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube dans Chrome"
          }
        }
      }
    },
    "Your Apple Reminders next to your calendar: tick them off or add one from the island.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus Recordatorios de Apple junto a tu calendario: márcalos o añade uno desde la isla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos rappels Apple à côté de votre calendrier : cochez-les ou ajoutez-en un depuis l’îlot."
          }
        }
      }
    },
    "Your script scrolls out of the notch, right under the camera, at your pace.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu texto sale del notch, justo bajo la cámara, a tu ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre texte défile depuis l’encoche, juste sous la caméra, à votre rythme."
          }
        }
      }
    },
    "edit": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "editar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "modifier"
          }
        }
      }
    },
    "ls, cat, grep, git status, diff and log, on ordinary files in the project. Hidden files, anything outside the project and names that look like secrets are always asked about.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ls, cat, grep, git status, diff y log, en archivos normales del proyecto. Siempre se pregunta por los archivos ocultos, lo que está fuera del proyecto y los nombres que parecen secretos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ls, cat, grep, git status, diff et log, sur des fichiers ordinaires du projet. Les fichiers cachés, tout ce qui est hors du projet et les noms qui ressemblent à des secrets sont toujours demandés."
          }
        }
      }
    },
    "macOS asks first: choose Always Allow for Topsail.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pregunta primero: elige Permitir siempre para Topsail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demande d’abord : choisissez Toujours autoriser pour Topsail."
          }
        }
      }
    },
    "now": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ahora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "à l’instant"
          }
        }
      }
    },
