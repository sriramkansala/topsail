    "Topsail handles the volume and brightness keys itself; while Spotify plays on another device, the volume keys control that device. Needs Input Monitoring and Accessibility permission.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Topsail gestiona las teclas de volumen y brillo; cuando Spotify suena en otro dispositivo, las teclas de volumen lo controlan. Necesita Monitorización de entrada y Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Topsail gère lui-même les touches de volume et de luminosité ; quand Spotify joue sur un autre appareil, les touches de volume le contrôlent. Nécessite Surveillance de l’entrée et Accessibilité."
          }
        }
      }
    },
    "Topsail is up to date.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Topsail está actualizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Topsail est à jour."
          }
        }
      }
    },
    "Topsail isn't allowed to record the screen.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Topsail no tiene permiso para grabar la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Topsail n’est pas autorisé à enregistrer l’écran."
          }
        }
      }
    },
    "Topsail isn't allowed to use the microphone.": {
      "localizations": {
        "es": {
          "stringUnit": {
