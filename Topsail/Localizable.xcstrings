    "Start it from the island's  %@  button or the menu bar. Space pauses, ↑ ↓ change speed, Esc closes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inícialo con el botón  %@  de la isla o desde la barra de menús. Espacio pausa, ↑ ↓ cambian la velocidad, Esc cierra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez-le avec le bouton  %@  de l’îlot ou depuis la barre des menus. Espace met en pause, ↑ ↓ changent la vitesse, Échap ferme."
          }
        }
      }
    },
    "Start the teleprompter": {
      "localizations": {
