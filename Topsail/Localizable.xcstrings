    },
    "“Copied to clipboard” under the notch; hover it for what you copied.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Copiado al portapapeles» bajo el notch; pasa el puntero para ver lo que copiaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Copié dans le presse-papiers » sous l’encoche ; survolez-le pour voir vos copies."
          }
        }
      }
    },
    "How Topsail opens and responds.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo se abre y responde Topsail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment Topsail s’ouvre et réagit."
          }
        }
      }
    },
    "What shows up in the notch, and the pages it opens to.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que aparece en el notch y las páginas que abre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui apparaît dans l’encoche, et les pages sur lesquelles elle s’ouvre."
          }
        }
      }
    },
    "The apps and services Topsail connects to.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps y los servicios a los que se conecta Topsail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps et services auxquels Topsail se connecte."
          }
        }
      }
    },
    "A light tap on the trackpad as the island opens.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un leve toque en el trackpad al abrirse la isla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un léger retour du trackpad quand l’îlot s’ouvre."
          }
        }
      }
