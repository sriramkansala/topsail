    "Drag a task onto another to merge them, or onto its lower edge to make it a sub-task. Double-click a title to rename.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra una tarea sobre otra para combinarlas, o sobre su borde inferior para hacerla subtarea. Haz doble clic en un título para cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser une tâche sur une autre pour les fusionner, ou sur son bord inférieur pour en faire une sous-tâche. Double-cliquez sur un titre pour le renommer."
          }
        }
      }
    },
    "Drag files here to keep them at hand": {
      "localizations": {
