    },
    "Drag files onto the notch to keep them at hand across apps; drag them back out, or AirDrop them from there.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra archivos al notch para tenerlos a mano entre apps; arrástralos de vuelta o envíalos por AirDrop desde ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser des fichiers sur l’encoche pour les garder sous la main d’une app à l’autre ; ressortez-les en les faisant glisser, ou envoyez-les par AirDrop."
          }
        }
      }
    },
