    "The download couldn't be opened.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir la descarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement n’a pas pu être ouvert."
          }
        }
      }
    },
    "The download isn't a newer version, so it wasn't installed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga no es una versión más nueva, así que no se instaló."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement n’est pas une version plus récente, il n’a donc pas été installé."
          }
        }
      }
    },
    "The download isn't signed by Topsail's developer, so it wasn't installed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga no está firmada por el desarrollador de Topsail, así que no se instaló."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement n’est pas signé par le développeur de Topsail, il n’a donc pas été installé."
          }
        }
      }
    },
    "The last %lld things you copied, kept in memory while Topsail runs; pin one to keep it on this Mac for good. Never sent anywhere, and passwords are skipped.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las últimas %lld cosas que copiaste, en memoria mientras Topsail está abierto; fija una para conservarla en este Mac. Nunca se envían, y se omiten las contraseñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos %lld dernières copies, gardées en mémoire tant que Topsail est ouvert ; épinglez-en une pour la conserver sur ce Mac. Jamais envoyées, et les mots de passe sont ignorés."
          }
        }
      }
    },
    "Thinking": {
