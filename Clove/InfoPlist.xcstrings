{
  "sourceLanguage": "en",
  "strings": {
    "NSAppleEventsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clove shows what is playing in Music or Spotify and lets you control playback from the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clove muestra lo que suena en Música o Spotify y te permite controlarlo desde el notch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clove affiche la lecture de Musique ou Spotify et vous permet de la contrôler depuis l’encoche."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clove shows your headphones’ battery when they connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clove muestra la batería de tus auriculares cuando se conectan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clove affiche la batterie de vos écouteurs quand ils se connectent."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clove shows your upcoming events when you open the notch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clove muestra tus próximos eventos cuando abres el notch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clove affiche vos prochains événements quand vous ouvrez l’encoche."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clove listens while you record a voice note about your tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clove escucha mientras grabas una nota de voz sobre tus tareas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clove écoute pendant que vous enregistrez une note vocale sur vos tâches."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clove shows your reminders in the notch, and lets you tick them off or add one there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clove muestra tus recordatorios en el notch y te permite marcarlos o añadir uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clove affiche vos rappels dans l’encoche et vous permet de les cocher ou d’en ajouter."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice notes are transcribed on this Mac to update your Linear tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus notas de voz se transcriben en este Mac para actualizar tus tareas de Linear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos notes vocales sont transcrites sur ce Mac pour mettre à jour vos tâches Linear."
          }
        }
      }
    }
  },
  "version": "1.0"
}